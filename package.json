{
  "name": "climbing-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check . && node scripts/check-no-compound-jsx.mjs",
    "lint:fix": "biome check --write . && node scripts/check-no-compound-jsx.mjs",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "build:scripts": "esbuild scripts/migrate.ts scripts/seed.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outdir=build-scripts",
    "db:seed:prod": "node build-scripts/seed.js"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/client-ses": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@mantine/core": "9.7.4",
    "@mantine/dates": "9.7.4",
    "@mantine/form": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/notifications": "9.7.4",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.4",
    "next-auth": "5.0.0-beta.32",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "postcss": "^8.5.0",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome"
    ]
  }
}
