# --- Database (Coolify Postgres container) ---
DATABASE_URL=postgres://climb:climb@localhost:5432/climb

# --- Auth.js (JWT sessions, see ADR 0005) ---
AUTH_SECRET=openssl rand -base64 32
APP_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# --- AWS (S3 media + SES mail) ---
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=staging/
SES_FROM=no-reply@example.com
# console = print mails to stdout (local dev), ses = send for real
MAIL_TRANSPORT=console

# --- Bootstrap admin (seed script only) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
